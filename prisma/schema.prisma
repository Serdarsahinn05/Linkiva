generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (Better Auth core schema) ──────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// Better Auth twoFactor plugin: set once a TOTP code has been verified.
  twoFactorEnabled Boolean?   @default(false)
  /// Staff role (Faz 19). Not a Better Auth field: no auth endpoint can read or write it. The first admin is set with
  /// scripts/set-role.mjs; after that only an admin changes roles, from the panel, logged in admin_audit.
  role          UserRole  @default(USER)
  sessions      Session[]
  accounts      Account[]
  twoFactors    TwoFactor[]
  profile       Profile?
  deletion      AccountDeletion?

  @@map("user")
}

enum UserRole {
  USER
  /// Reviews reports and removes content; cannot change roles or delete accounts.
  MODERATOR
  ADMIN
}

/// A visitor's report about a page or one of its blocks (Faz 19, /report/<username>). Gone with the page; resolved ones
/// are deleted after REPORT_KEEP_DAYS by the daily clean-up. The reporter's email is optional and only for a reply.
model Report {
  id         String       @id @default(cuid())
  profileId  String
  profile    Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  blockId    String?
  block      Block?       @relation(fields: [blockId], references: [id], onDelete: SetNull)
  reason     ReportReason
  details    String?
  email      String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
  /// Staff user id; the audit log has the full record.
  resolvedBy String?

  @@index([status, createdAt])
  @@index([profileId])
  @@map("report")
}

enum ReportReason {
  SPAM
  SCAM
  ILLEGAL
  ADULT
  HATE
  IMPERSONATION
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

/// A staff member confirmed their two-step code on this session (lib/admin.ts): sensitive admin actions need it
/// within the last ten minutes. Ends with the session.
model AdminStepUp {
  sessionId  String   @id
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  verifiedAt DateTime

  @@map("admin_step_up")
}

/// Every staff action: who, when, what, on whom, why. Append-only: a database trigger refuses UPDATE, DELETE and
/// TRUNCATE (migration 20261007090000_admin_foundation). No foreign keys, so the record outlives deleted accounts;
/// people are kept as ids plus the label they had at the time (a username or "@username"), never an email.
model AdminAudit {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now())
  actorId     String
  actorLabel  String
  action      String
  targetType  String?
  targetId    String?
  targetLabel String?
  reason      String?
  meta        Json     @default("{}")

  @@index([at])
  @@index([targetType, targetId])
  @@map("admin_audit")
}

/// Fixed-window counters for the app's own rate limits (lib/ratelimit.ts): subscribe, tracking beacon, import, domains.
/// The key is a SHA-256 of "<limit>:<ip or user id>", so no IP address is stored. Expired rows go in the daily clean-up.
model RateCounter {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_counter")
}

/// A deletion the owner asked for: the page is taken offline at once and everything is erased at purgeAt
/// (features/account/deletion.ts) unless the owner signs in and restores the account first.
model AccountDeletion {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAt  DateTime @default(now())
  purgeAt      DateTime
  /// Profile.isPublished before the request, given back on restore.
  wasPublished Boolean

  @@index([purgeAt])
  @@map("account_deletion")
}

/// Better Auth twoFactor plugin: the TOTP secret and the backup codes, both encrypted with BETTER_AUTH_SECRET.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminStepUp AdminStepUp?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Better Auth rate-limit counters (storage: "database"), shared across serverless instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ─── Linkiva ─────────────────────────────────────────────────────────────────

model Profile {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  username       String       @unique
  displayName    String?
  bio            String?
  avatarUrl      String?
  theme          String       @default("cam")
  appearance     Json         @default("{}")
  seoTitle       String?
  seoDescription String?
  showBranding   Boolean      @default(true)
  isPublished    Boolean      @default(true)
  locale         String       @default("tr")
  timezone       String       @default("Europe/Istanbul")
  /// Weekly summary mail (opt-out in settings or via the signed link in the mail).
  weeklyDigest   Boolean      @default(true)
  /// Last weekly summary claimed for this profile; guards against double sends.
  digestSentAt   DateTime?
  /// The editor's "Getting started" card was closed (Faz 18); it stays closed on every device.
  guideDismissedAt DateTime?
  /// Suspended by staff (Faz 19): offline ("Bu sayfaya şu an ulaşılamıyor"), and the owner cannot publish it again.
  suspendedAt    DateTime?
  blocks         Block[]
  socials        SocialLink[]
  events         Event[]
  subscribers    Subscriber[]
  reports        Report[]
  pastUsernames  UsernameHistory[]
  customDomain   CustomDomain?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("profile")
}

enum BlockType {
  LINK
  HEADER
  TEXT
  EMBED
  EMAIL_CAPTURE
  DIVIDER
  IMAGE
  SUPPORT
  WHATSAPP
  CONTACT
  PRODUCT
  COUNTDOWN
  PROJECT
  EXPERIENCE
  SKILLS
}

/// Tile size in the grid layout (ROADMAP Faz 10). Ignored by the list layout.
enum BlockSize {
  SMALL
  WIDE
  LARGE
}

model Block {
  id            String    @id @default(cuid())
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type          BlockType
  position      Int
  isVisible     Boolean   @default(true)
  isHighlighted Boolean   @default(false)
  size          BlockSize @default(WIDE)
  /// Shape depends on `type`; always parsed through lib/validation/blocks.ts
  data          Json
  startsAt      DateTime?
  endsAt        DateTime?
  events        Event[]
  linkCheck     LinkCheck?
  reports       Report[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([profileId, position])
  @@map("block")
}

enum LinkStatus {
  OK
  BROKEN
}

/// The daily reachability check of a block's destination (ROADMAP Faz 13). Only results of real requests are stored.
model LinkCheck {
  blockId    String     @id
  block      Block      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  /// The address that was checked. A block whose destination changed starts over.
  url        String
  /// null: not judged (not a web address, a private network address, too many redirects). Never shown as broken.
  status     LinkStatus?
  /// Consecutive failed checks of `url`; the editor flags the block from 2 on.
  failCount  Int        @default(0)
  checkedAt  DateTime
  /// The owner was mailed about this failure: once, until the link works again or changes.
  notifiedAt DateTime?

  @@index([checkedAt])
  @@map("link_check")
}

enum SocialPlatform {
  INSTAGRAM
  X
  TIKTOK
  YOUTUBE
  GITHUB
  LINKEDIN
  TWITCH
  SPOTIFY
  DISCORD
  BEHANCE
  DRIBBBLE
  EMAIL
  WEBSITE
}

model SocialLink {
  id        String         @id @default(cuid())
  profileId String
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform  SocialPlatform
  handle    String
  position  Int

  @@unique([profileId, platform])
  @@map("social_link")
}

enum EventType {
  VIEW
  CLICK
}

enum Device {
  MOBILE
  DESKTOP
  TABLET
}

model Event {
  id           BigInt    @id @default(autoincrement())
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  blockId      String?
  block        Block?    @relation(fields: [blockId], references: [id], onDelete: SetNull)
  type         EventType
  visitorHash  String
  country      String?   @db.Char(2)
  city         String?
  device       Device?
  os           String?
  browser      String?
  referrerHost String?
  utmSource    String?
  /// Atomic de-duplication: visitor + target + time bucket. A concurrent repeat violates the unique index.
  dedupeKey    String?   @unique
  createdAt    DateTime  @default(now())

  @@index([profileId, createdAt])
  @@index([blockId, createdAt])
  @@map("event")
}

model Subscriber {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([profileId, email])
  @@map("subscriber")
}

/// The owner's own domain, served by this profile once verified (ROADMAP Faz 11). One per profile.
model CustomDomain {
  id         String    @id @default(cuid())
  profileId  String    @unique
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Lower-case ASCII (punycode) host name, without port.
  hostname   String    @unique
  /// Set once Vercel reports the domain verified and its DNS pointing at us; the domain serves the profile only then.
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("custom_domain")
}

/// A username the profile used before. It keeps redirecting to the current one and stays unclaimable until expiresAt.
model UsernameHistory {
  username  String   @id
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([profileId, createdAt])
  @@map("username_history")
}
