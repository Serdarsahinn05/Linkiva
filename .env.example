# Database (Supabase): pooled URL for the app, direct URL for migrations
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/postgres"

# Auth (Better Auth)
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mail (Resend). Without a key, development mails are written to tmp/mailbox/ (preview: /api/dev/mail).
RESEND_API_KEY=""
MAIL_FROM="Linkiva <hello@linkiva.space>"

# Rate limiting (optional: when empty, an in-memory limiter is used; fine locally, weak on serverless)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# File uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Analytics: secret used to derive the daily visitor-hash salt
TRACKING_SALT_SECRET="generate-with: openssl rand -base64 32"

# Scheduled jobs (weekly summary mail): Vercel Cron sends this as a Bearer token. Empty = jobs off.
CRON_SECRET="generate-with: openssl rand -base64 32"

# Custom domains (docs/DEPLOY.md → Özel alan adı): a Vercel access token for this project, the project id, and the team id
# when the project belongs to a team. Empty = the feature is hidden.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# Local setup: put overrides (localhost DB, secrets) in .env.local; it wins over .env.
# Optional, local only: the production DB under names the app never reads, for applying migrations by hand
# (docs/DEPLOY.md). PROD_DATABASE_URL="..." PROD_DIRECT_URL="..."
